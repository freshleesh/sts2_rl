<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- game DLLs pinned by tools/pin_game.py (not in git); override with -p:Sts2LibDir=... -->
    <Sts2LibDir Condition="'$(Sts2LibDir)' == ''">$(MSBuildThisFileDirectory)lib</Sts2LibDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="lib/**;old/**" />
    <Reference Include="sts2"><HintPath>$(Sts2LibDir)/sts2.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2LibDir)/GodotSharp.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2LibDir)/0Harmony.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(Sts2LibDir)/GAME_VERSION.json" Condition="Exists('$(Sts2LibDir)/GAME_VERSION.json')" CopyToOutputDirectory="PreserveNewest" Link="GAME_VERSION.json" />
  </ItemGroup>
  <Target Name="CheckPinnedGame" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(Sts2LibDir)/sts2.dll')">
    <Error Text="Game DLLs not found in $(Sts2LibDir). Run: python tools/pin_game.py" />
  </Target>
</Project>
